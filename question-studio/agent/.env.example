FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
# Omit for Application Default Credentials in a supported cloud environment.
GOOGLE_APPLICATION_CREDENTIALS=
AGENT_STATE_PATH=questionAuthoring/main
AGENT_DATA_DIR=.data/agent
# Virtual loopback origin for local font rendering; no HTTP server is required.
AGENT_RENDER_ORIGIN=
# Leave empty to use Playwright's installed Chromium.
AGENT_BROWSER_CHANNEL=
AGENT_LEASE_MS=600000
AGENT_MIN_QUESTIONS=6
AGENT_MAX_QUESTIONS=16
AGENT_RENDER_RETRY_MS=15000
